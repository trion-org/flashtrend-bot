# Copy to .env (git-ignored). Only these four are required for the MVP.
YOUTUBE_API_KEY=AIzaSy_your_key_here
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ_your_service_role_here
GEMINI_API_KEY=your-google-ai-studio-key

# Optional: image upload endpoint of the parent system (POST multipart `file`, answers {"url": ...}).
# Unset = the run chart is not uploaded.
S3_URL=https://upload.example/api/v1/files/upload
S3_URL=

